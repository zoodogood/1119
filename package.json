{
	"name": "greenghost",
	"version": "2.0.0-alpha.31505",
	"type": "module",
	"description": "",
	"main": "index.js",
	"scripts": {
		"pm2:start": "pm2 start --interpreter ~/.bun/bin/bun ./index.js --name 1119",
		"start": "bun run ./index.js",
		"watch-runtime": "node --watch ./index.js",
		"build": "node ./folder/scripts/build.bat.js",
		"site-build": "vite build --config ./src/site/vite.config.js",
		"site-watch": "sirv static --no-clear",
		"createPagesExports": "node ./src/site/scripts/createPagesExports.js",
		"pm2:please-restart": "pm2 restart --update-env",
		"docker": "docker-compose up -d --build && echo 'Hello, do use pm2 list and pm2 logs <id> for the read stdout' && docker-compose exec greenghost /bin/bash"
	},
	"imports": {
		"#root/*": "./*",
		"#src/*": "./src/*",
		"#config": "./src/config.json.js",
		"#app": "./src/app/app.js",
		"#server/*": "./src/server/*",
		"#site/*": "./src/site/src/*",
		"#bot/*": "./src/bot/*",
		"#constants/*": "./src/constants/*",
		"#folder/*": "./folder/*",
		"#lib/*": "./src/lib/*",
		"#site-component-lib/*": "./src/site/src/components/*",
		"#site-component/*": "./src/site/src/components/*/mod.svelte"
	},
	"author": "zoodogood",
	"license": "ISC",
