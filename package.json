{
	"name": "greenghost",
	"type": "module",
	"version": "2.0.0-alpha.33877",
	"description": "",
	"author": "zoodogood",
	"license": "ISC",
	"main": "index.js",
	"scripts": {
		"start": "bun run ./index.js",
		"build": "node ./src/app/build/run_build.script.js",
		"docker": "docker-compose up -d --build && echo 'Hello, do use pm2 list and pm2 logs <id> for the read stdout' && docker-compose exec greenghost /bin/bash",
		"pm2:please-restart": "pm2 restart --update-env",
		"pm2:start": "pm2 start --interpreter ~/.bun/bin/bun ./index.js --name 1119",
		"site-build": "vite build --config ./src/site/build/vite.config.ts",
		"site-build:build_stages": "node ./src/site/build/build_by_stages.script.js --apply-all",
		"site-preview": "vite dev --config ./src/site/build/vite.config.ts",
		"watch-runtime": "bun --watch ./index.js"
	},
	"imports": {
		"#src/*": "./src/*",
		"#root/*": "./*",
		"#config": "./src/config.json.js",
		"#constants/*": "./src/constants/*",
		"#site-component-lib/*": "./src/site/build/components/lib/*",
		"#site-component/*": "./src/site/build/components/svelte/*/mod.svelte"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"@deepkit/bun": "1.0.1-alpha.158",
		"@deepkit/type": "1.0.1-alpha.158",
		"@discordjs/collection": "^2.1.1",
		"@zoodogood/utils": "7.0.0-change.4513",
		"body-parser": "^1.20.3",
		"cors": "^2.8.5",
		"dayjs": "^1.11.13",
		"discord-api-types": "^0.37.119",
		"discord-oauth2-utils": "^3.0.3",
		"discord.js": "^14.18.0",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"glob": "^11.0.1",
		"helmet": "^8.1.0",
		"mol_tree2": "^1.0.1008",
		"vm2": "^3.9.19",
		"yaml": "^2.7.0"
	},
	"// comment it's be ignored": {
		"optional_dependencies": {
			"canvas": "^2.11.2",
			"mongodb": "^6.5.0"
		}
	},
	"devDependencies": {
		"@antfu/eslint-config": "^4.10.1",
		"@eslint/js": "^9.24.0",
		"@rollup/plugin-commonjs": "^28.0.3",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@rollup/plugin-replace": "^6.0.2",
		"@rollup/plugin-terser": "^0.4.4",
		"@stylistic/eslint-plugin": "^4.2.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tsconfig/svelte": "^5.0.4",
		"@types/bun": "latest",
		"eslint": "^9.22.0",
		"eslint-plugin-format": "^1.0.1",
		"eslint-plugin-perfectionist": "^4.10.1",
		"eslint-plugin-svelte": "^3.3.2",
		"globals": "^16.0.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"rollup": "^4.36.0",
		"rollup-plugin-css-only": "^4.5.2",
		"rollup-plugin-livereload": "^2.0.5",
		"rollup-plugin-polyfill-node": "^0.13.0",
		"rollup-plugin-svelte": "^7.2.2",
		"svelte": "^5.23.2",
		"svelte-eslint-parser": "^1.1.0",
		"svelte-exmarkdown": "^4.0.3",
		"svelte-heatmap": "^1.0.2",
