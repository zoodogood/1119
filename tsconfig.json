{
  "compilerOptions": {
    "skipLibCheck": true,                              
    "allowJs": true,
    "module": "esnext",                                
    "esModuleInterop": true,                           
    "target": "esnext",                                
    "forceConsistentCasingInFileNames": true,          
    "strict": true,     
    // JS
		"baseUrl": ".",
		"paths": {
			"#config": ["./src/config.json.js"],
			"#app": ["./src/app/app.js"],

			"#site/*": ["./src/site/src/*"],
			"#bot/*": ["src/client/*"],
			"#constants/*": ["src/constants/*"],
			"#folder/*": ["./folder/*"],
			"#lib/*": ["./src/lib/*"],

			"#site-component-lib/*": ["./src/site/src/components/*"],
			"#site-component/*": ["./src/site/src/components/*/mod.svelte"],

			"#src/*": ["./src/*"],
			"#root/*": ["./*"]
		},
		"moduleResolution": "nodenext",
		"importHelpers": true,
		"checkJs": true,
		"resolveJsonModule": true,
		"outDir": "tsdist",
		"experimentalDecorators": true
	},
	"reflection": true,
	"extends": ["@tsconfig/svelte/tsconfig.json"],
	"exclude": ["node_modules", "**/node_modules", "dist"]
}
