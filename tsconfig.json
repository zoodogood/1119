{
	"compilerOptions": {
		"target": "esnext" ,
		"experimentalDecorators": true ,

		"baseUrl": "." ,
		"rootDir": "." ,
		"module": "nodenext" ,
		"moduleResolution": "nodenext" ,
		"paths": {
			"#config": ["./src/config.json.js"] ,
			"#app": ["./src/app/app.js"] ,

			"#constants/*": ["src/constants/*"] ,

			"#site-component-lib/*": ["src/site/_build/components/lib/*"] ,
			"#site-component/*": ["src/site/_build/components/svelte/*/mod.svelte"] ,

			"#src/*": ["./src/*"] ,
			"#root/*": ["./*"]
		} ,
		"resolveJsonModule": true ,
		"allowJs": true ,
		"checkJs": true ,
		"strict": true ,
		"importHelpers": true ,
		"outDir": "tsdist" ,
		"esModuleInterop": true ,
		"forceConsistentCasingInFileNames": true ,
		"skipLibCheck": true
	} ,
	"reflection": true ,
	"exclude": ["node_modules" , "**/node_modules" , "dist"]
}
