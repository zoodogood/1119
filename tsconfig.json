{
	"compilerOptions": {
		"target": "esnext" ,
		"lib": ["esnext" , "dom"] ,
		"experimentalDecorators": true ,
		"baseUrl": "." ,
		"rootDir": "." ,
		"module": "nodenext" ,
		"moduleResolution": "nodenext" ,
		"paths": {
			"#config": ["./src/config.json.js"] ,
			"#constants/*": ["src/constants/*"] ,
			"#site-component-lib/*": ["src/site/build/components/lib/*"] ,
			"#site-component/*": ["src/site/build/components/svelte/*/mod.svelte"] ,
			"#src/*": ["./src/*"] ,
			"#root/*": ["./*"]
		} ,
		"resolveJsonModule": true ,
		"types": ["@types/node"] ,
		"allowJs": true ,
		"checkJs": true ,
		"strict": false ,
		"importHelpers": true ,
		"noEmit": true ,
		"outDir": "tsdist" ,
		"esModuleInterop": true ,
		"forceConsistentCasingInFileNames": true ,
		"skipLibCheck": true
	} ,
	"reflection": true ,
	"exclude": ["node_modules" , "**/node_modules" , "src/site/build/_public_out"]
}
